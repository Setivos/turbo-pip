; Engine configuration file.
; Turbo Pip - Godot 4.7

config_version=5

[application]

config/name="Turbo Pip"
config/description="Jeu de plateforme runner : 6 mondes, 24 niveaux, 4 mini-jeux."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"
config/quit_on_go_back=false

[autoload]

Save="*res://scripts/save_data.gd"
Sfx="*res://scripts/sfx.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
environment/defaults/default_clear_color=Color(0.113725, 0.105882, 0.184314, 1)
anti_aliasing/quality/msaa_2d=1
